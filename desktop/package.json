{
  "name": "nya-entworks-desktop",
  "private": true,
  "version": "1.1.11",
  "description": "呜啊娱乐工坊 桌面壳（不承载业务，业务在后端 Spring Boot 里）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.Nyameph.nyaentworks",
    "productName": "呜啊娱乐工坊",
    "asar": true,
    "extraMetadata": {
      "productName": "呜啊娱乐工坊"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "trusted.js",
      "splash.html",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "build/staged/app.jar",
        "to": "app.jar"
      },
      {
        "from": "build/staged/jre",
        "to": "jre"
      },
      {
        "from": "build/staged/config",
        "to": "config"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "呜啊娱乐工坊-${version}.exe"
    },
    "directories": {
      "output": "dist"
    },
    "compression": "normal"
  }
}
